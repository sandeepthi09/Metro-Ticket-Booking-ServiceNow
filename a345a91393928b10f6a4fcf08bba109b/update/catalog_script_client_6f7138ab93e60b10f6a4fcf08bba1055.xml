        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {

    if (isLoading || !newValue) {
        return;
    }

    var selectedDate = new Date(newValue);

    // Get today's date
    var today = new Date();

    // Remove time from today's date
    today.setHours(0, 0, 0, 0);

    // Remove time from selected date
    selectedDate.setHours(0, 0, 0, 0);

    // Reject past dates
    if (selectedDate < today) {

        g_form.showFieldMsg(
            'travel_date',
            'Invalid date. Please select today or a future date.',
            'error'
        );

        alert('Invalid Travel Date\n\nPlease select today or a future date.');

        g_form.clearValue('travel_date');
    }
}]]></script>
